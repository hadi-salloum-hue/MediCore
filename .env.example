# Public base URL of the site (used for metadata / hreflang)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact email: shown as an "Email us" button in the contact section and in the privacy notice.
NEXT_PUBLIC_CONTACT_EMAIL=

# WhatsApp number for the "WhatsApp" button: international format, digits only, no "+" or spaces
# (example: 962791234567). Leave empty to hide the button.
# If both the email and the WhatsApp number are empty, the contact button opens the demo request form.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Where demo requests are forwarded (server-side only). Any HTTPS endpoint that accepts a JSON POST
# (e.g. a form service or your own inbox automation).
# In production the API returns an error if this is empty, so the form never pretends to send.
DEMO_REQUEST_WEBHOOK_URL=

# Legal pages (Privacy Notice). The organization name and the contact email are printed in the notice.
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
# Set to true ONLY after a lawyer approved the privacy notice: removes the "draft" banner and allows search engines to index the page.
NEXT_PUBLIC_LEGAL_REVIEWED=false
